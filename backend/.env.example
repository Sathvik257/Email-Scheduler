NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

ETHEREAL_ACCOUNTS_JSON=[{"key":"sender-a","name":"ReachInbox Sender A","email":"sender-a@ethereal.email","user":"replace","pass":"replace","host":"smtp.ethereal.email","port":587,"secure":false},{"key":"sender-b","name":"ReachInbox Sender B","email":"sender-b@ethereal.email","user":"replace","pass":"replace","host":"smtp.ethereal.email","port":587,"secure":false}]
